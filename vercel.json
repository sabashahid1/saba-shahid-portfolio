{
  "version": 2,
  "builds": [
    { "src": "css/**", "use": "@vercel/static" },
    { "src": "js/**", "use": "@vercel/static" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "admin.html", "use": "@vercel/static" },
    { "src": "api/index.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "api/index.js" },
    { "src": "/admin", "dest": "admin.html" },
    { "src": "/css/(.*)", "headers": { "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400" }, "dest": "css/$1" },
    { "src": "/js/(.*)", "headers": { "Cache-Control": "public, max-age=3600, stale-while-revalidate=86400" }, "dest": "js/$1" },
    { "src": "/uploads/(.*)", "headers": { "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800" }, "dest": "uploads/$1" },
    { "src": "/(.*)", "dest": "index.html" }
  ]
}

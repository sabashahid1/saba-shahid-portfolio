# Saba Shahid Portfolio Environment Variables Configuration Template
# Duplicate this file, rename it to '.env', and fill in your actual credentials.

# Port for local web server (default is 3000)
PORT=3000

# Transactional SMTP Server Configuration
# Examples: smtp.gmail.com (Gmail), smtp.mailgun.org (Mailgun), smtp.sendgrid.net (SendGrid)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# SMTP Auth Credentials (use App Passwords for Gmail, do NOT use your master password)
SMTP_USER=sabaashahidd111@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Destination inbox where you want to receive visitor inquiries
RECEIVER_EMAIL=sabaashahidd111@gmail.com
